DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/interactive_whiteboard
PORT=3000
WEB_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
HOST=0.0.0.0
# Production: TRUST_PROXY=loopback, REQUIRE_ORIGIN=true, COOKIE_SECURE=true, WEB_ORIGIN=https://your-domain
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# SMTP_LOCAL_RELAY=true is allowed only with a loopback SMTP host (local Exim).
MAIL_FROM=BluviBoard <no-reply@bluviboard.local>
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# Assign boards created before authentication to this verified account:
# LEGACY_OWNER_EMAIL=you@example.com

# Image files: local (default) or s3 (Yandex Object Storage).
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=your-static-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
