[Unit]
Description=BluviBoard API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=bluviboard
Group=bluviboard
WorkingDirectory=/opt/bluviboard/current/apps/server
EnvironmentFile=/etc/bluviboard/server.env
ExecStart=/usr/local/bin/node dist/main.js
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bluviboard/uploads /var/lib/bluviboard/site-files
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=128
LimitNOFILE=16384
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
